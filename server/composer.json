{
    "name": "tome/tomeapi",
    "version": "1.0.0",
    "description": "The backend/server/api for T.O.M.E. - Training Organization Made Easy ",
    "keywords": [
        "laravel",
        "api",
        "boilerplate",
        "jwt",
        "auth",
        "rest"
    ],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.4",
        "grohiro/laravel-camelcase-json": "^2.0.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "intervention/image": "^4.0",
        "intervention/image-laravel": "^4.0",
        "kreait/firebase-php": "^8.0",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0",
        "maatwebsite/excel": "^4.0",
        "php-open-source-saver/jwt-auth": "^2.9",
        "spatie/laravel-permission": "^8.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.13",
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.0",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^12.5",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "classmap": [
            "database"
        ],
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\": "tests/",
            "Tests\\": "tests/",
            "Database\\Factories\\": "database/factories/"
        }
    },
    "scripts": {
        "post-root-package-install": [
            "php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "php artisan key:generate",
            "php artisan jwt:secret -f"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.4.1"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
