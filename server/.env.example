APP_NAME="TOME"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tome
DB_USERNAME=tome
DB_PASSWORD=tome

# JWT
JWT_SECRET=

# Mail
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@example.com

# Firebase Cloud Messaging (requires service account JSON file)
# Path to the Firebase service account JSON file (relative to project root)
# Download from: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
FIREBASE_CREDENTIALS_PATH=storage/firebase-service-account.json

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
