APP_NAME="TOME"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tome
DB_USERNAME=tome
DB_PASSWORD=tome

# Logging (daily files, kept for LOG_DAILY_DAYS days)
LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=14

# Sanctum SPA authentication: session cookie (HttpOnly, SameSite=Lax) on the app's own host
SESSION_DRIVER=file
SESSION_LIFETIME=20160
# true in production (HTTPS)
SESSION_SECURE_COOKIE=false
# hosts (with port) the SPA is served from; requests from them get session + CSRF
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000

# Mail
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@example.com

# Datenaufbewahrung (DSGVO): `php artisan tome:retention` loescht inaktive Benutzer (Trainer und Admins nie).
# Der monatliche Lauf (am 1. um 03:00) ist standardmaessig AUS; erst nach Pruefung mit
# `php artisan tome:retention --dry-run` auf true setzen. Ein manueller Aufruf funktioniert immer.
RETENTION_ENABLED=false
# Nach wie vielen Monaten ohne Teilnahme (und bei Konten aelter als dieser Zeitraum) Benutzer geloescht werden
RETENTION_INACTIVE_MONTHS=24

# Firebase Cloud Messaging (requires service account JSON file)
# Path to the Firebase service account JSON file (relative to project root)
# Download from: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
FIREBASE_CREDENTIALS_PATH=storage/firebase-service-account.json

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
