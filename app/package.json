{
  "name": "tome-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:serve": "npm run build && npm run deploy",
    "deploy": "rm -rf ../server/public_app && mkdir -p ../server/public_app && cp -r dist/* ../server/public_app/",
    "watch": "npm run build -- --watch && npm run deploy",
    "watch:deploy": "chokidar 'src/**/*' -c 'npm run build:serve'",
    "preview": "vite preview",
    "lint": "eslint --fix .",
    "lint:check": "eslint .",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mdi/font": "^7.4.0",
    "apexcharts": "^5.10.0",
    "firebase": "^13.0.0",
    "jwt-decode": "^4.0.0",
    "moment": "^2.29.4",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-cal": "^4.10.0",
    "vue-router": "^5.4.0",
    "vue3-apexcharts": "^1.11.1",
    "vuetify": "^4.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "chokidar-cli": "^3.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "sass": "^1.75.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
