{
  "name": "tome-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:serve": "npm run build && npm run deploy",
    "deploy": "mkdir -p ../server/public_app && find ../server/public_app -mindepth 1 -delete && cp -r dist/* ../server/public_app/",
    "watch": "npm run build -- --watch && npm run deploy",
    "preview": "vite preview",
    "lint": "eslint --fix .",
    "lint:check": "eslint .",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node e2e/run.mjs"
  },
  "dependencies": {
    "@mdi/font": "^7.4.0",
    "apexcharts": "^8.3.1",
    "dayjs": "^1.11.23",
    "firebase": "^13.0.0",
    "jwt-decode": "^4.0.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-cal": "^4.10.0",
    "vue-router": "^5.4.0",
    "vue3-apexcharts": "^1.11.3",
    "vuetify": "^4.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1",
    "sass": "^1.105.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
