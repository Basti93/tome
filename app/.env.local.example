# Firebase Cloud Messaging Configuration
# Copy this file to .env.local and fill in your Firebase project details
# Never commit .env.local to version control!

# Get these values from your Firebase Console:
# 1. Go to Project Settings
# 2. Under "Your apps" section, find your web app
# 3. Copy the configuration values below

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your_project.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Web Push certificate key pair (Firebase Console > Project Settings > Cloud Messaging > Web Push certificates).
# Required for push notifications; without it the app silently skips push registration.
VITE_FIREBASE_VAPID_KEY=your_vapid_public_key

# Optional: Override API URL for development
# VITE_APP_API_URL=/api/v1

# Matomo Analytics Configuration (not secret; safe to keep defaults)
VITE_MATOMO_ENABLED=true
# Use relative path through nginx proxy (same origin, no CORS issues)
VITE_MATOMO_URL=/matomo/
VITE_MATOMO_SITE_ID=1
