# Beispielwerte fuer die lokale Simulation (kein echter Standort). Verwendung:
#   SITE_ENV_FILE=deploy/prod-sim/site.env.sim   (Mac-Seite, deploy.sh/rollback.sh/smoke)
# Im Container ist SITE_ENV_FILE per docker-compose bereits gesetzt.
SITE_HOST=training.example.org
SITE_ALIAS=www.training.example.org
SITE_CERT_DIR=/etc/letsencrypt/live/example.org
SITE_ADMIN_EMAIL=admin@example.org
MAIL_FROM_ADDRESS=noreply@example.org
MAIL_FROM_NAME=Training Example
