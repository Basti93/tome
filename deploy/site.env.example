# Standortspezifische Konfiguration. Kopieren nach deploy/site.env (steht in .gitignore, nie einchecken).
# Wird von deploy.sh, rollback.sh, server-setup.sh und matomo-setup.sh gelesen. Auf dem Server muss die
# Datei neben den Skripten liegen (beim Kopieren von deploy/ auf den Server wird sie mitkopiert).
# Keine Anfuehrungszeichen noetig; Werte ohne Leerzeichen am Rand.

# Hostname der App (Vhost ServerName, Health-Check, Standard fuer --host)
SITE_HOST=training.example.org
# Zusaetzlicher Hostname, der auf SITE_HOST weiterleitet (z. B. www)
SITE_ALIAS=www.training.example.org
# Verzeichnis des Zertifikats (enthaelt fullchain.pem und privkey.pem), z. B. Let's Encrypt
SITE_CERT_DIR=/etc/letsencrypt/live/example.org

# Kontaktadresse im Apache-Vhost (ServerAdmin)
SITE_ADMIN_EMAIL=admin@example.org

# Absender der E-Mails (werden nur beim ersten Anlegen der .env eingetragen)
MAIL_FROM_ADDRESS=noreply@example.org
MAIL_FROM_NAME=Training Example
